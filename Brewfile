# Core tooling for these dotfiles. Machine-specific extras go in ~/Brewfile.local
brew "rcm"                      # dotfile symlink manager (rcup / lsrc)
brew "git"
brew "gh"                       # GitHub CLI (also used as git credential helper)
brew "zsh"
brew "zsh-syntax-highlighting"
brew "vim"
brew "tmux"
brew "fzf"
brew "the_silver_searcher"      # ag — used by vim + fzf
brew "universal-ctags"          # used by git_template hooks
brew "asdf"                     # language version manager (~/.tool-versions)
brew "jq"
brew "uv"                       # python tooling

cask "iterm2"
